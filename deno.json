{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "compilerOptions": {
    "types": ["npm:@telegraf/types", "npm:@types/ramda"]
  },
  "tasks": {
    "dev": "deno run --env-file --watch --allow-all --unstable-cron --unstable-kv main.ts",
    "migrate": "deno run --unstable-kv migrate.ts",
    "init-config": "op inject --in-file .env.example --out-file .env --force",
    "deploy": "",
    "tunnel": "cloudflared tunnel run --token $(op read op://Project/flowerss-worker/tunnel-token)"
  },
  "imports": {
    "@telegraf/types": "npm:@telegraf/types@9.2.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "fast-xml-parser": "npm:fast-xml-parser@5.5.10",
    "ky": "npm:ky@1.14.3",
    "ramda": "npm:ramda@0.32.0",
    "typed-inject": "npm:typed-inject@^5.0.0"
  }
}
